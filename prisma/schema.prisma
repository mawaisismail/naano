// Only the MUTABLE half of the product lives here.
//
// Creators are static seed data in src/lib/creators.ts — they do not change at
// runtime, so they are not rows. A Deal references a creator by its seed id.
// That keeps browsing the marketplace working with no database attached.
//
// Postgres everywhere — local, CI and production. There is no second provider
// and no datasource switching: the database the tests run against is the same
// engine that serves production, so a query that works in CI works deployed.
//
// Status fields are strings with the allowed values documented beside them and
// enforced by the lifecycle state machine in src/lib/lifecycle.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Connection URL lives in prisma.config.ts (Prisma 7 moved it out of the schema).
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String
  // "brand" | "creator"
  role         String
  // brands only
  companyName  String?
  // creators only: the slug this creator is booked under. For the demo account
  // it points at a seeded creator; for a real signup it is generated at
  // onboarding and must not collide with a seeded one.
  // Not a database unique constraint: uniqueness must also hold against the
  // seeded creators in src/lib/creators.ts, which are not rows, so the check
  // lives in reserveCreatorSlug() where it can see both sets.
  creatorSlug  String?
  createdAt    DateTime   @default(now())

  // ---- signup provenance --------------------------------------------------
  // "email" | "google" | "linkedin_oidc". passwordHash is empty for a user who
  // only ever arrived through OAuth, so the login action must refuse a password
  // sign-in for them rather than comparing against "".
  authProvider      String  @default("email")
  // The provider's stable subject claim. Unique per provider so a second login
  // links to the same row instead of creating a duplicate account.
  providerAccountId String?
  // Free-text attribution answer from the sign-up form. Optional on purpose:
  // a required question here costs more signups than the answer is worth.
  heardAbout        String?

  // ---- email verification -------------------------------------------------
  // The verification email is not sent in this build: there is no mailbox to
  // send from yet. The STATE is still modelled and written on every signup, so
  // turning it on later is a matter of sending the mail and flipping the flag,
  // not a schema change. OAuth signups arrive already verified because the
  // provider asserted the address.
  emailVerified     Boolean   @default(false)
  emailVerifiedAt   DateTime?

  // ---- creator onboarding -------------------------------------------------
  // Which step of the 4-step wizard this creator has reached, so a refresh or
  // a "finish later" resumes where they stopped instead of starting over.
  onboardingStep    Int       @default(1)
  linkedinUrl       String?
  linkedinImportedAt DateTime?
  // "demo" until a real LinkedIn import exists. Every figure derived from an
  // import is labelled in the UI from this field rather than a hardcoded
  // string, so the day the API is wired in, the labels disappear on their own.
  profileDataSource String    @default("demo")
  industries        String[]

  // ---- professional details, optional at signup ---------------------------
  // naano lets a creator enter the workspace before filling these in and
  // blocks payouts until they exist, which is what the nullable columns mean.
  businessCountry   String?
  hasBusiness       Boolean?
  legalName         String?
  legalAddress      String?
  taxDeclarationAcceptedAt DateTime?
  invoiceMandateAcceptedAt DateTime?

  // ---- payouts, for the Earnings screen -----------------------------------
  // "bank" | "stripe". Nothing is moved by this build: no payment processor is
  // connected, so the screen reports the state honestly and the withdraw
  // button stays disabled until one is.
  payoutMethod      String   @default("stripe")
  bankAccountHolder String?
  bankIban          String?
  stripeAccountId   String?

  // ---- affiliate program --------------------------------------------------
  // The code in naano.com/invite/<code>. Unique so a referral resolves to one
  // person; generated at signup rather than derived from the id, because an id
  // in a public URL is a free enumeration handle.
  referralCode      String?  @unique
  // Who introduced this account, if anyone.
  referredById      String?
  referredAt        DateTime?

  @@unique([authProvider, providerAccountId])

  // ---- creator profile, filled in by the onboarding wizard ----------------
  // Null until onboarding completes. A creator with no profile has no
  // marketplace card, so no brand can find or book them.
  onboardedAt      DateTime?
  headline         String?
  bio              String?
  country          String?
  countryCode      String?
  flag             String?
  // Native Postgres text[]. These were comma-joined strings only because the
  // project used to have to run on SQLite as well, which has no array type.
  verticals        String[]
  icp              String[]
  avatarUrl        String?
  followers        Int?
  medianViews      Int?
  postCost         Int?
  reactionsPerPost Int?
  commentsPerPost  Int?

  campaigns    Campaign[]
}

model Campaign {
  id          String   @id @default(cuid())
  brand       User     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  brandId     String
  name        String
  objective   String
  // the AI-drafted brief, rendered from the campaign inputs
  keyMessages String
  guidelines  String
  landingUrl  String
  // "draft" | "live" | "complete"
  status      String   @default("draft")
  createdAt   DateTime @default(now())

  // ---- what the creator-side Opportunities board filters on ---------------
  // "linkedin" today; the column exists because naano's board has a channel
  // switcher above it and a single-value enum would have to be migrated the
  // moment a second channel appears.
  channel     String   @default("linkedin")
  industries  String[]
  countries   String[]
  // The date a creator's post has to be live by. Null means the brand has not
  // set one, which the board renders as "No deadline" rather than inventing one.
  postDeadline DateTime?

  deals       Deal[]

  @@index([brandId])
}

model Deal {
  id          String   @id @default(cuid())
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId  String
  // seed creator id, e.g. "cr_007" — not a foreign key by design
  creatorId   String
  creatorSlug String
  creatorName String
  price       Int
  // "invited" | "accepted" | "declined" | "draft" | "scheduled" | "live" | "paid"
  status      String   @default("invited")
  // the short code behind /r/<code>; this is what makes attribution per-creator
  trackingCode String  @unique
  postUrl     String?
  publishedAt DateTime?
  createdAt   DateTime @default(now())

  clicks      Click[]
  messages    Message[]

  @@index([campaignId])
  @@index([creatorSlug])
}

model Click {
  id           String   @id @default(cuid())
  deal         Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  dealId       String
  trackingCode String
  referer      String?
  userAgent    String?
  // Salted hash of the client IP, never the IP itself. Used only to collapse
  // rapid repeats from one source; not reversible and not for identification.
  ipHash       String?
  createdAt    DateTime @default(now())

  @@index([dealId])
  @@index([trackingCode])
  @@index([dealId, ipHash, createdAt])
}

/// A one-time 6-digit code for password recovery.
///
/// The code itself is never stored — only a SHA-256 of it, the same way a
/// password is handled, so a dump of this table cannot be replayed against
/// anyone's account. Rows are consumed on use and expire after 15 minutes.
model PasswordResetCode {
  id        String   @id @default(cuid())
  email     String
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([email])
}

/// One message in the conversation attached to a booking.
///
/// Threads hang off a Deal rather than off a pair of users: a conversation
/// between a brand and a creator is always about a specific booking, and
/// keying it that way means authorisation is the same question as "is this
/// deal yours", which both sides already answer.
model Message {
  id         String   @id @default(cuid())
  deal       Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  dealId     String
  /// "brand" | "creator" — which side wrote it.
  senderRole String
  senderName String
  body       String
  createdAt  DateTime @default(now())
  /// Set when the other side has opened the thread.
  readAt     DateTime?

  @@index([dealId])
}
