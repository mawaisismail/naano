# ---------------------------------------------------------------------------
# Copy to .env and fill in. Postgres is required — there is no local fallback.
# ---------------------------------------------------------------------------

# Postgres connection string, the same engine locally, in CI and in production.
# Local:  docker run -d -p 5432:5432 -e POSTGRES_PASSWORD=naano postgres:17
#         then DATABASE_URL="postgresql://postgres:naano@localhost:5432/naano"
# Hosted: Neon, Supabase or Vercel Postgres all work unchanged.
# On Vercel, POSTGRES_PRISMA_URL is injected for you and takes over automatically.
DATABASE_URL="postgresql://postgres:naano@localhost:5432/naano"

# Direct, unpooled URL. Migrations and schema pushes must not go through
# pgbouncer, which rejects the session-level statements they issue. Optional
# locally; set it in production if your host gives you a separate direct URL.
DIRECT_DATABASE_URL=""

# Postgres schema used by the integration tests. They create it, push the real
# schema into it and drop it afterwards, so they never touch your data.
# Leave unset and the database-backed tests skip with a message.
TEST_DATABASE_URL=""

# Signs session cookies, and salts the IP hash used to collapse duplicate clicks.
# Generate your own:  openssl rand -base64 32
# REQUIRED in production — the app refuses to start without at least 32 chars,
# because a predictable secret means anyone can forge a session for any account.
SESSION_SECRET=""

# Absolute origin of the deployed site, e.g. https://naano-rebuild.vercel.app
# Only used to resolve Open Graph URLs, so link previews are not broken.
# Optional locally; falls back to http://localhost:3000
NEXT_PUBLIC_SITE_URL=""
