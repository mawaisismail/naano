# ---------------------------------------------------------------------------
# Copy to .env and fill in. Postgres is required — there is no local fallback.
# ---------------------------------------------------------------------------

# Postgres connection string, the same engine locally, in CI and in production.
# Local:  docker run -d -p 5433:5432 -e POSTGRES_PASSWORD=naano postgres:16-alpine
#         then DATABASE_URL="postgresql://postgres:naano@localhost:5433/naano"
# Hosted: Neon, Supabase or Vercel Postgres all work unchanged.
# On Vercel, POSTGRES_PRISMA_URL is injected for you and takes over automatically.
DATABASE_URL="postgresql://postgres:naano@localhost:5433/naano"

# Direct, unpooled URL. Migrations and schema pushes must not go through
# pgbouncer, which rejects the session-level statements they issue. Optional
# locally; set it in production if your host gives you a separate direct URL.
DIRECT_DATABASE_URL=""

# Postgres schema used by the integration tests. They create it, push the real
# schema into it and drop it afterwards, so they never touch your data.
# Leave unset and the database-backed tests skip with a message.
TEST_DATABASE_URL=""

# Signs session cookies, and salts the IP hash used to collapse duplicate clicks.
# Generate your own:  openssl rand -base64 32
# REQUIRED in production — the app refuses to start without at least 32 chars,
# because a predictable secret means anyone can forge a session for any account.
SESSION_SECRET=""

# Absolute origin of the deployed site, e.g. https://naano-rebuild.vercel.app
# Only used to resolve Open Graph URLs, so link previews are not broken.
# Optional locally; falls back to http://localhost:3000
NEXT_PUBLIC_SITE_URL=""

# ---------------------------------------------------------------------------
# OAuth sign-in. Both providers are optional: with no credentials set, the
# sign-up page shows "not configured" on those buttons and email still works.
#
# Redirect URI to register with BOTH providers:
#   http://localhost:3000/api/auth/oauth/callback   (local)
#   https://<your-domain>/api/auth/oauth/callback   (deployed)
# ---------------------------------------------------------------------------

# Google Cloud console -> APIs & Services -> Credentials -> OAuth client ID
# (Web application). Scopes used: openid email profile.
GOOGLE_CLIENT_ID="dummy-google-client-id"
GOOGLE_CLIENT_SECRET="dummy-google-client-secret"

# LinkedIn developer portal -> your app -> Auth. Request the "Sign In with
# LinkedIn using OpenID Connect" product; the older r_liteprofile scopes are
# not granted to new apps. Scopes used: openid profile email.
LINKEDIN_CLIENT_ID="dummy-linkedin-client-id"
LINKEDIN_CLIENT_SECRET="dummy-linkedin-client-secret"

# ---------------------------------------------------------------------------
# Transactional email — password recovery codes. Optional: with no key the
# code is written to the server log instead of being sent, which is what you
# want locally and never what you want in production.
# ---------------------------------------------------------------------------
RESEND_API_KEY="dummy-resend-api-key"
EMAIL_FROM="Naano <no-reply@example.com>"
