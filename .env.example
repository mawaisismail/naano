# ---------------------------------------------------------------------------
# Local development: copy to .env and it works as-is. No signup, no cloud.
# ---------------------------------------------------------------------------

# SQLite locally. In production this must be a Postgres URL — serverless
# filesystems are read-only and ephemeral, so a deployed SQLite database loses
# its click history between invocations. Run `npm run use:postgres` first.
DATABASE_URL="file:./dev.db"

# Signs session cookies, and salts the IP hash used to collapse duplicate clicks.
# Generate your own:  openssl rand -base64 32
# REQUIRED in production — the app refuses to start without at least 32 chars,
# because a predictable secret means anyone can forge a session for any account.
SESSION_SECRET=""

# Absolute origin of the deployed site, e.g. https://naano-rebuild.vercel.app
# Only used to resolve Open Graph URLs, so link previews are not broken.
# Optional locally; falls back to http://localhost:3000
NEXT_PUBLIC_SITE_URL=""
