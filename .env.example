# ---------------------------------------------------------------------------
# Copy to .env and fill in. Postgres is required — there is no local fallback.
# ---------------------------------------------------------------------------

# Postgres connection string, the same engine locally, in CI and in production.
# This project points local AND production at one managed database on purpose,
# so "works on my machine" and "works deployed" are the same claim.
# Local alternative: docker run -d -p 5433:5432 -e POSTGRES_PASSWORD=naano postgres:16-alpine
# Hosted: Aiven, Neon, Supabase or Vercel Postgres all work unchanged.
# On Vercel, POSTGRES_PRISMA_URL is injected for you and takes over automatically.
DATABASE_URL="postgresql://user:password@host:5432/defaultdb?sslmode=require"

# Direct, unpooled URL. Migrations and schema pushes must not go through
# pgbouncer, which rejects the session-level statements they issue. Optional
# locally; set it in production if your host gives you a separate direct URL.
DIRECT_DATABASE_URL=""

# The managed provider's CA certificate, in PEM, newlines and all.
#
# sslmode=require encrypts but does NOT verify — on its own it accepts any
# certificate presented, which stops a passive eavesdropper and does nothing
# about an active one. With this set, the chain is actually checked, and the
# driver drops sslmode from the URL so the two cannot disagree. Leave it empty
# for a local Postgres with no TLS.
DATABASE_CA_CERT=""

# Postgres schema used by the integration tests. They create it, migrate the
# real schema into it and drop it afterwards, so they never touch your data —
# pointing this at the same database as DATABASE_URL is safe by design.
# Leave unset and the database-backed tests skip with a message.
TEST_DATABASE_URL=""

# ---------------------------------------------------------------------------
# Redis / Valkey. Backs the rate limiter.
#
# Without it, limits are counted per process: N servers means N times the
# limit, and on serverless every cold start hands out a fresh budget — which
# is not a limit at all. With it, "10 login attempts a minute" means ten.
# rediss:// for TLS, which managed providers require.
#
# If it is unreachable the limiter falls back to counting in memory rather
# than failing open: taking Redis down must not switch rate limiting off.
# ---------------------------------------------------------------------------
REDIS_URL=""

# Signs session cookies, and salts the IP hash used to collapse duplicate clicks.
# Generate your own:  openssl rand -base64 32
# REQUIRED in production — the app refuses to start without at least 32 chars,
# because a predictable secret means anyone can forge a session for any account.
SESSION_SECRET=""

# Absolute origin of the deployed site, e.g. https://naano-rebuild.vercel.app
# Only used to resolve Open Graph URLs, so link previews are not broken.
# Optional locally; falls back to http://localhost:3000
NEXT_PUBLIC_SITE_URL=""

# ---------------------------------------------------------------------------
# OAuth sign-in. Both providers are optional: with no credentials set, the
# sign-up page shows "not configured" on those buttons and email still works.
#
# Redirect URI to register with BOTH providers:
#   http://localhost:3000/api/auth/oauth/callback   (local)
#   https://<your-domain>/api/auth/oauth/callback   (deployed)
# ---------------------------------------------------------------------------

# Google Cloud console -> APIs & Services -> Credentials -> OAuth client ID
# (Web application). Scopes used: openid email profile.
GOOGLE_CLIENT_ID="dummy-google-client-id"
GOOGLE_CLIENT_SECRET="dummy-google-client-secret"

# LinkedIn developer portal -> your app -> Auth. Request the "Sign In with
# LinkedIn using OpenID Connect" product; the older r_liteprofile scopes are
# not granted to new apps. Scopes used: openid profile email.
LINKEDIN_CLIENT_ID="dummy-linkedin-client-id"
LINKEDIN_CLIENT_SECRET="dummy-linkedin-client-secret"

# ---------------------------------------------------------------------------
# Transactional email — password recovery codes. Optional: with no key the
# code is written to the server log instead of being sent, which is what you
# want locally and never what you want in production.
# ---------------------------------------------------------------------------
# With no provider configured, password reset falls back to a fixed demo PIN
# (123456) shown on the reset screen. That is an account-takeover hole, so it
# is only allowed outside production; set this to 1 to allow it on a hosted
# demo deliberately. Configure a real provider and the fallback disappears on
# its own — demoResetEnabled() returns false the moment a key and a from
# address both exist.
DEMO_PASSWORD_RESET="0"

RESEND_API_KEY="dummy-resend-api-key"

# One thing that costs people an afternoon: a provider accepts the API key and
# still refuses to deliver until a sending DOMAIN is verified. Until then only
# the account owner's own address receives anything, and every other recipient
# comes back 403. Verify a domain, then set this to an address on it.
# resend.dev addresses work for testing without any verification.
EMAIL_FROM="Naano <onboarding@resend.dev>"

# ---------------------------------------------------------------------------
# Exa — the web read behind step 1 of brand onboarding. The contents endpoint
# extracts the site (and an about or pricing subpage, because a homepage
# rarely states who the product is FOR).
#
# Without a key the read falls back to text generated from the domain, and
# every screen says so: brandDataSource is written as "demo" instead of
# "crawler", and the wizard's note renders from that column.
# ---------------------------------------------------------------------------
EXA_API_KEY=""

# ---------------------------------------------------------------------------
# Cloudflare Workers AI. Two models, both called server-side:
#   @cf/meta/llama-3.3-70b-instruct-fp8-fast   site text -> value prop + ICPs
#   @cf/baai/bge-base-en-v1.5                  embeddings behind AI Matching
#
# The API token needs the "Workers AI: Read" permission and nothing else.
# Without these, matching falls back to word-overlap scoring and the screen
# says which ranking produced the list.
# ---------------------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""
