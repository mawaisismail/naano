#!/usr/bin/env bash
# Blocks a commit if a credential-shaped string appears in staged .agent-logs/.
# BLOCKS rather than edits: 8x forbids editing log entries after the fact, and
# prevention beats rewriting history plus rotating a leaked key.
set -uo pipefail

staged=$(git diff --cached --name-only --diff-filter=ACM | grep '^\.agent-logs/' || true)
[ -z "$staged" ] && exit 0

# Shapes that must never reach a public log. This is the last line of defence:
# scripts/redact.mjs already strips them when the log is generated, and this
# blocks the commit if one ever gets past it. redis/rediss and the Resend
# prefix were added after a real key was pasted into a prompt and neither the
# generic patterns nor the URI ones would have caught it.
PATTERNS='sk-[A-Za-z0-9_-]{16,}|sk-ant-[A-Za-z0-9_-]{16,}|gh[pousr]_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|re_[A-Za-z0-9_]{20,}|AKIA[0-9A-Z]{16}|ASIA[0-9A-Z]{16}|AIza[0-9A-Za-z_-]{30,}|xox[baprs]-[A-Za-z0-9-]{10,}|AVNS_[A-Za-z0-9_-]{16,}|-----BEGIN [A-Z ]*PRIVATE KEY-----|eyJ[A-Za-z0-9_-]{20,}\.[A-Za-z0-9_-]{20,}\.[A-Za-z0-9_-]{10,}|(mongodb(\+srv)?|postgres(ql)?|rediss?|amqps?)://[^[:space:]/]*:[^[:space:]@]+@|(api[_-]?key|secret|passwd|password|token)[[:space:]]*[=:][[:space:]]*[A-Za-z0-9_\-]{24,}'

# Strings the repo already publishes about itself are not disclosures.
# .env.example and the CI workflow both carry the local Postgres placeholder
# (postgres:naano@localhost), so a log that quotes it reveals nothing that is
# not already committed in plain sight. Anything NOT found there still blocks.
# This reads the committed copies, so a placeholder cannot be introduced in the
# same commit it is used to excuse.
published=$(
  { git show HEAD:.env.example; git show HEAD:.github/workflows/ci.yml; } 2>/dev/null
)

hits=0
while IFS= read -r f; do
  [ -f "$f" ] || continue
  # -o so each match is judged on its own; a line may hold more than one.
  matches=$(git show ":$f" | grep -noEi "$PATTERNS" || true)
  [ -z "$matches" ] && continue

  unexplained=""
  while IFS= read -r m; do
    [ -z "$m" ] && continue
    text=${m#*:}
    if [ -n "$published" ] && printf '%s' "$published" | grep -qF -- "$text"; then
      continue
    fi
    unexplained="${unexplained}${m}"$'\n'
  done <<< "$matches"

  if [ -n "$unexplained" ]; then
    echo "BLOCKED: credential-shaped string in $f" >&2
    printf '%s' "$unexplained" | sed 's/^/    /' | cut -c1-160 >&2
    hits=1
  fi
done <<< "$staged"

if [ "$hits" -ne 0 ]; then
  cat >&2 <<'MSG'

Commit blocked by .githooks/pre-commit.

.agent-logs/ is published publicly and permanently. Do not edit the log entry to
hide this — 8x forbids editing entries. Instead: rotate the credential if it is
real, and unstage the file. If this is a false positive, re-run with --no-verify.
MSG
  exit 1
fi
exit 0
