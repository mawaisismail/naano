#!/usr/bin/env bash
# Blocks a commit if a credential-shaped string appears in staged .agent-logs/.
# BLOCKS rather than edits: 8x forbids editing log entries after the fact, and
# prevention beats rewriting history plus rotating a leaked key.
set -uo pipefail

staged=$(git diff --cached --name-only --diff-filter=ACM | grep '^\.agent-logs/' || true)
[ -z "$staged" ] && exit 0

PATTERNS='sk-[A-Za-z0-9_-]{16,}|sk-ant-[A-Za-z0-9_-]{16,}|gh[pousr]_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|AKIA[0-9A-Z]{16}|ASIA[0-9A-Z]{16}|AIza[0-9A-Za-z_-]{30,}|xox[baprs]-[A-Za-z0-9-]{10,}|-----BEGIN [A-Z ]*PRIVATE KEY-----|eyJ[A-Za-z0-9_-]{20,}\.[A-Za-z0-9_-]{20,}\.[A-Za-z0-9_-]{10,}|mongodb(\+srv)?://[^[:space:]/]*:[^[:space:]@]+@|postgres(ql)?://[^[:space:]/]*:[^[:space:]@]+@|(api[_-]?key|secret|passwd|password|token)[[:space:]]*[=:][[:space:]]*[A-Za-z0-9_\-]{24,}'

hits=0
while IFS= read -r f; do
  [ -f "$f" ] || continue
  if out=$(git show ":$f" | grep -nEi "$PATTERNS"); then
    echo "BLOCKED: credential-shaped string in $f" >&2
    echo "$out" | sed 's/^/    /' | cut -c1-160 >&2
    hits=1
  fi
done <<< "$staged"

if [ "$hits" -ne 0 ]; then
  cat >&2 <<'MSG'

Commit blocked by .githooks/pre-commit.

.agent-logs/ is published publicly and permanently. Do not edit the log entry to
hide this — 8x forbids editing entries. Instead: rotate the credential if it is
real, and unstage the file. If this is a false positive, re-run with --no-verify.
MSG
  exit 1
fi
exit 0
